# Server
PORT=3000
CORS_ORIGIN=http://localhost:3001
# Set to true when running behind a reverse proxy (nginx) so rate limiting sees real client IPs
TRUST_PROXY=false
# Timezone for dashboard "today / this week" boundaries
APP_TIMEZONE=Asia/Kolkata

# Database (defaults match the docker-compose Postgres)
DB_USER=admin
DB_PASSWORD=admin123
DB_HOST=localhost
DB_PORT=5433
DB_NAME=lsm

# Auth
# Random secret that signs session tokens (min 32 chars). Generate: openssl rand -base64 48
JWT_SECRET=
# How long a login lasts
SESSION_TTL_HOURS=12
# true when served over HTTPS (browsers ignore Secure cookies on plain HTTP)
COOKIE_SECURE=false

# Staff login created by `npm run seed` (first run only; change later with `npm run staff:password`)
STAFF_NAME=Shop Operator
STAFF_USERNAME=admin
# Min 10 characters
STAFF_PASSWORD=
