# Copy to .env and fill in. Never commit .env.
#   cp .env.example .env

# ---- App ----------------------------------------------------------------------
# Host interface and port the app is served on (nginx: UI + /api proxy)
APP_BIND=0.0.0.0
APP_PORT=8080
# Public address people use, e.g. https://lsm.joatverse.com
PUBLIC_URL=http://localhost:8080
APP_TIMEZONE=Asia/Kolkata

# ---- Database -----------------------------------------------------------------
POSTGRES_USER=lsm
# Long random value: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=lsm
# Host port for local tools only (bound to 127.0.0.1)
POSTGRES_PORT=5433
POSTGRES_VOLUME=lsm_postgres_data

# ---- Auth ---------------------------------------------------------------------
# Signs session tokens, min 32 chars: openssl rand -base64 48
JWT_SECRET=
SESSION_TTL_HOURS=12
# true when people reach the app over HTTPS (e.g. through Cloudflare).
# With true, logging in over plain http://<lan-ip>:port will not stick.
COOKIE_SECURE=false
# Staff login, created on first start if missing (password min 10 chars).
# Change later: docker compose exec backend node dist/scripts/set-staff-password.js
STAFF_NAME=Shop Operator
STAFF_USERNAME=admin
STAFF_PASSWORD=

# ---- Release watcher (deployer service) -----------------------------------------
# Enable ONLY in the server checkout that should follow GitHub releases
AUTO_DEPLOY_ENABLED=false
GITHUB_REPO=pxndavinci/laptop-service-management
# Optional: raises the GitHub API rate limit / needed if the repo becomes private
GITHUB_TOKEN=
DEPLOY_WINDOW_START=23:00
DEPLOY_WINDOW_END=07:00
DEPLOY_TIMEZONE=Asia/Kolkata
POLL_INTERVAL_SECONDS=600
BACKUP_KEEP=14
# Host user that owns this checkout (id -u / id -g) and the docker socket group
# (stat -c %g /var/run/docker.sock)
LSM_UID=1000
LSM_GID=1000
DOCKER_GID=962
